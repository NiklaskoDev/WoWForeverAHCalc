# Copy this file to .env and fill it in. Keep .env private: it holds your API secret.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# eu or us
FOREVER_REGION=eu

# 1 = PvP, 2 = Normal, 3 = Roleplay, 15 = Roleplay PvP
FOREVER_RULESET=2

# The number shown in the app's auction house list, e.g. 113 for "Market 1 - Horde (#113)"
FOREVER_HOUSE=113

# How often to check for new data. Blizzard updates roughly hourly.
POLL_MINUTES=20
